{
  "name": "@thm/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env --watch --import tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=../../.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=../../.env --import tsx src/db/migrate.ts",
    "db:seed": "node --env-file=../../.env --import tsx src/db/seed-reference.ts"
  },
  "dependencies": {
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@thm/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.3",
    "fastify-type-provider-zod": "^7.0.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10"
  }
}
