# ---------------------------------------------------------------------------
# Copier ce fichier en `.env` a la racine puis adapter les valeurs.
#   cp .env.example .env
# `.env` est ignore par git et ne doit JAMAIS etre commite.
# ---------------------------------------------------------------------------

# --- PostgreSQL (consomme par docker-compose.yml ET par l'API) ---
POSTGRES_USER=thm
POSTGRES_PASSWORD=thm_local_dev_only
POSTGRES_DB=thm_roadmap
POSTGRES_PORT=5432

# Chaine de connexion de l'API. Doit rester coherente avec les 4 variables
# ci-dessus tant que Postgres tourne dans docker-compose.
DATABASE_URL=postgres://thm:thm_local_dev_only@localhost:5432/thm_roadmap

# --- API (apps/api) ---
API_HOST=127.0.0.1
API_PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# --- Web (apps/web) ---
# Aucune variable secrete cote front : tout ce qui est prefixe VITE_ est
# embarque en clair dans le bundle et donc public par nature.
# En dev, l'API est atteinte via le proxy Vite (meme origine), pas via une URL absolue.
