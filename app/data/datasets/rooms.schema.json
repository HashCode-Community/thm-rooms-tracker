{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/<org>/thm-roadmap/data/datasets/rooms.schema.json",
  "title": "TryHackMe free rooms dataset",
  "type": "object",
  "required": [
    "meta",
    "rooms"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "datasetVersion",
        "scrapedAt",
        "source",
        "freeRoomsCount",
        "checksum"
      ],
      "properties": {
        "datasetVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "scrapedAt": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "totalRoomsInCatalog": {
          "type": "integer",
          "minimum": 0
        },
        "catalogCountReportedByApi": {
          "type": "integer",
          "minimum": 0
        },
        "freeRoomsCount": {
          "type": "integer",
          "minimum": 0
        },
        "checksum": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "checksumAlgorithm": {
          "type": "string"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "rooms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "code",
          "title",
          "difficulty",
          "type",
          "url"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Identifiant stable TryHackMe. CLE PRIMAIRE. Jamais le titre."
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "difficulty": {
            "enum": [
              "info",
              "easy",
              "medium",
              "hard",
              "insane"
            ]
          },
          "type": {
            "enum": [
              "walkthrough",
              "challenge"
            ]
          },
          "durationMinutes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "usersCount": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "publishedAt": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "teams": {
            "type": "array",
            "items": {
              "enum": [
                "Red",
                "Blue",
                "Purple"
              ]
            },
            "maxItems": 3
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "technologies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://tryhackme\\.com/room/"
          }
        }
      }
    }
  }
}