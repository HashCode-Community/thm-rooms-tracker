{
  "name": "@thm/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --conditions=development --import tsx --test tests/*.test.ts",
    "contrast": "node --conditions=development --import tsx scripts/verifie-contrastes.ts",
    "build:analyse": "vite build --sourcemap && node --import tsx scripts/analyse-bundle.ts",
    "langue": "node --conditions=development --import tsx scripts/verifie-langue.ts"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.35",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@thm/shared": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.2.2"
  }
}
