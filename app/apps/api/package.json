{
  "name": "@thm/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env --watch --import tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=../../.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=../../.env --import tsx src/db/migrate.ts",
    "db:seed": "node --env-file=../../.env --import tsx src/db/seed-reference.ts",
    "typecheck:guard": "node --import tsx scripts/assert-probe-bites.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/dataset-stats.test.ts",
    "test:api": "vitest run tests/api",
    "roadmap:seed": "node --env-file=../../.env --import tsx src/scripts/seed-roadmap.ts",
    "roadmap:candidates": "node --env-file=../../.env --import tsx src/scripts/roadmap-candidates.ts"
  },
  "dependencies": {
    "@fastify/compress": "9.2.0",
    "@fastify/cors": "11.3.0",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@thm/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.3",
    "fastify-type-provider-zod": "^7.0.0",
    "postgres": "^3.4.9",
    "yaml": "^2.9.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "vitest": "^5.0.0"
  }
}
